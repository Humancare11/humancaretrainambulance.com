# Copy to .env (never commit .env). Local XAMPP example.
APP_ENV=local
DB_HOST=127.0.0.1
DB_NAME=tam_blog_local
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Comma-separated origins allowed for cross-origin dev requests
CORS_ORIGINS=http://localhost:5173
# Used only by backend/database/setup-admin.php (min 12 chars); remove from .env after setup
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
